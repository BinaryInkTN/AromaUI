Window {
    width: 360
    height: 400
    title: "Buttons"

    Label { text: "Button Styles" x: 20 y: 20 style: "large" }

    Button { text: "Default" x: 20 y: 60 width: 120 height: 40 }

    Card {
        x: 20
        y: 120
        width: 320
        height: 60
        title: "Filled Button"
    }

    IconButton {
        x: 20
        y: 200
        width: 48
        height: 48
        icon: "AROMA_ICON_FAVORITE"
        variant: filled
    }

    IconButton {
        x: 80
        y: 200
        width: 48
        height: 48
        icon: "AROMA_ICON_FAVORITE"
        variant: outlined
    }

    IconButton {
        x: 140
        y: 200
        width: 48
        height: 48
        icon: "AROMA_ICON_FAVORITE"
        variant: standard
    }

    Chip {
        x: 20
        y: 260
        label: "Label"
        icon: "AROMA_ICON_STAR"
        type: choice
        selected: true
    }

    Chip {
        x: 120
        y: 260
        label: "Filter"
        type: filter
        selected: false
    }

    Chip {
        x: 220
        y: 260
        label: "Suggestion"
        type: suggestion
    }
}
