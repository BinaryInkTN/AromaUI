[submodule "vendors/emscripten"]
	path = vendors/emscripten
	url = https://github.com/emscripten-core/emsdk.git
[submodule "vendors/glps"]
	path = vendors/glps
	url = https://github.com/BinaryInkTN/GLPS
[submodule "vendors/freetype"]
	path = vendors/freetype
	url = https://github.com/freetype/freetype.git
[submodule "vendors/glfw"]
	path = vendors/glfw
	url = https://github.com/glfw/glfw.git
[submodule "vendors/sqlite3"]
	path = vendors/sqlite3
	url = https://github.com/azadkuh/sqlite-amalgamation.git
[submodule "vendors/ctypesgen"]
	path = vendors/ctypesgen
	url = https://github.com/ctypesgen/ctypesgen.git
[submodule "vendors/ffmpeg"]
	path = vendors/ffmpeg
	url = https://github.com/FFmpeg/FFmpeg.git
	branch = n8.0
	shallow = true
[submodule "vendors/litehtml"]
	path = vendors/litehtml
	url = https://github.com/litehtml/litehtml.git
	branch = master
	shallow = true
[submodule "vendors/quickjs"]
	path = vendors/quickjs
	url = https://github.com/bellard/quickjs.git
	branch = master
	shallow = true
