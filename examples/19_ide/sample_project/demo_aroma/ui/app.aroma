Window {
    width: 800
    height: 600
    title: "demo_aroma"

    Card {
        x: 0
        y: 0
        width: 228
        height: 600
        type: filled
        color: "#171A21"
        corner_radius: 0

        Label { text: "demo_aroma" x: 24 y: 28 style: "large" }
        Label { text: "NOTES" x: 24 y: 62 style: "small" }
        Button {
            text: "New note"
            x: 24
            y: 94
            width: 180
            height: 44
            type: filled
            on_click: "new_note"
        }
        Label { text: "Welcome" x: 24 y: 172 style: "medium" }
        Label { text: "Drag a Label or Button onto this page." x: 24 y: 198 style: "small" }
    }

    Label { text: "Today" x: 260 y: 32 style: "large" }
    Card {
        x: 260
        y: 80
        width: 500
        height: 150
        type: elevated
        corner_radius: 12

        Label { text: "Your first card" x: 22 y: 20 style: "large" }
        Label { text: "Edit the markup in Code view or drop widgets here." x: 22 y: 56 style: "small" }
    }
    Card {
        x: 260
        y: 250
        width: 500
        height: 120
        type: outlined
        corner_radius: 12

        Label { text: "Next steps" x: 22 y: 20 style: "medium" }
        Label { text: "Press F7 to build and F5 to run the project." x: 22 y: 52 style: "small" }
    }
    Label { id: "status" text: "Ready" x: 260 y: 410 style: "small" }
}
