Window {
    width: 760
    height: 520
    title: "Aroma"
    Card {
        x: 0
        y: 0
        width: 220
        height: 520
        type: filled
        color: "#171A21"
        corner_radius: 0
    }
    Card {
        x: 0
        y: 0
        width: 3
        height: 520
        type: filled
        color: "#F97316"
        corner_radius: 0
    }
    Label {
        text: "AROMA NOTES"
        x: 24
        y: 26
        style: "small"
    }
    Label {
        text: "Inbox"
        x: 24
        y: 50
        style: "large"
    }
    Button {
        text: "New note"
        x: 17
        y: 106
        width: 172
        height: 44
        type: filled
        icon: "AROMA_ICON_HOME"
        on_click: "new_note"
    }
    Label {
        text: "PINNED"
        x: 24
        y: 166
        style: "small"
    }
    Card {
        x: 16
        y: 190
        width: 188
        height: 64
        type: elevated
        corner_radius: 10
        Label {
            text: "Release checklist"
            x: 16
            y: 12
            style: "medium"
        }
        Label {
            text: "3 tasks remaining"
            x: 16
            y: 36
            style: "small"
        }
    }
    Card {
        x: 16
        y: 264
        width: 188
        height: 64
        type: outlined
        corner_radius: 10
        Label {
            text: "Design review"
            x: 16
            y: 12
            style: "medium"
        }
        Label {
            text: "Tomorrow at 10:00"
            x: 16
            y: 36
            style: "small"
        }
    }
    Label {
        text: "RECENT"
        x: 24
        y: 356
        style: "small"
    }
    Label {
        text: "Language services"
        x: 24
        y: 382
        style: "medium"
    }
    Label {
        text: "Incense schema notes"
        x: 24
        y: 404
        style: "small"
    }
    Label {
        text: "Window sizing"
        x: 24
        y: 426
        style: "small"
    }
    Label {
        text: "Today"
        x: 252
        y: 26
        style: "large"
    }
    Label {
        text: "A calm place for release notes and interface sketches."
        x: 252
        y: 56
        style: "small"
    }
    Card {
        x: 252
        y: 92
        width: 480
        height: 142
        type: elevated
        corner_radius: 12
        Label {
            text: "Ship the note editor"
            x: 22
            y: 18
            style: "large"
        }
        Label {
            text: "Wire the AromaUI callbacks, then verify the markup preview."
            x: 22
            y: 50
            style: "small"
        }
        Label {
            text: "Updated just now"
            x: 22
            y: 104
            style: "small"
        }
    }
    Card {
        x: 252
        y: 250
        width: 480
        height: 118
        type: outlined
        corner_radius: 12
        Label {
            text: "Explore Incense widgets"
            x: 22
            y: 18
            style: "medium"
        }
        Label {
            text: "Cards, labels and buttons are ready for the next screen."
            x: 22
            y: 48
            style: "small"
        }
        Label {
            text: "Yesterday"
            x: 22
            y: 82
            style: "small"
        }
    }
    Card {
        x: 252
        y: 384
        width: 480
        height: 74
        type: outlined
        corner_radius: 12
        Label {
            text: "Tune the orange accent"
            x: 22
            y: 14
            style: "medium"
        }
        Label {
            text: "Keep the palette warm against the dark surface."
            x: 22
            y: 40
            style: "small"
        }
    }
    Label {
        id: "status"
        text: "Ready - 3 notes"
        x: 252
        y: 482
        style: "small"
    }
}
