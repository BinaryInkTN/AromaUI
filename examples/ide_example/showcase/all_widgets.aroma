Window {
    width: 400
    height: 600
    title: "Widget Showcase"

    Label { text: "Widget Showcase" x: 20 y: 20 style: "large" }
    Label { text: "A quick tour of every widget" x: 20 y: 60 style: "medium" color: "#888888" }

    Button { text: "Button" x: 20 y: 120 width: 100 height: 40 }
    Switch { x: 140 y: 120 }
    Checkbox { text: "Check" x: 240 y: 120 }

    Slider { x: 20 y: 180 width: 360 min: 0 max: 100 value: 30 }

    Textbox { text: "Text input" x: 20 y: 240 width: 170 height: 40 }
    ProgressBar { value: 0.6 x: 210 y: 240 width: 170 height: 20 }

    Card {
        x: 20
        y: 300
        width: 360
        height: 120
        title: "Card Title"
        subtitle: "Card subtitle text"
    }

    IconButton {
        x: 20
        y: 440
        width: 48
        height: 48
        icon: "AROMA_ICON_FAVORITE"
        variant: filled
    }

    Loading {
        x: 100
        y: 440
        radius: 16
        thickness: 3
    }

    Chip {
        x: 200
        y: 440
        label: "Tag"
        type: filter
    }
}
