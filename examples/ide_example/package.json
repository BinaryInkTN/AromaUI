{
  "name": "aromaui-ide",
  "version": "1.0.0",
  "description": "AromaUI Incense IDE - Desktop editor for Incense UI markup",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_NO_ATTACH_CONSOLE electron .",
    "build": "electron-builder",
    "package": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.aromaui.ide",
    "productName": "AromaUI IDE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "build_web/**/*",
      "!build_web/*.cmake",
      "!build_web/CMakeCache.txt",
      "!build_web/CMakeFiles/**/*",
      "!build_web/Makefile",
      "!build_web/cmake_install.cmake",
      "showcase/**/*"
    ],
    "win": {
      "target": [
        [
          "nsis",
          "zip"
        ]
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        [
          "AppImage",
          "deb",
          "tar.gz"
        ]
      ]
    }
  },
  "dependencies": {
    "monaco-editor": "^0.45.0"
  }
}
