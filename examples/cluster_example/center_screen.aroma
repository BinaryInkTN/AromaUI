
        Container {
            id:     "center_section"
            x:      320
            y:      0
            width:  560
            height: 312

            Tabs {
                id:     "center_tabs"
                x:      0
                y:      250
                width:  560
                height: 50
                hidden: true
                selected: 0
                Tab {
                    text: "Performance"

                    ScrollView {
                    width: 560
                    height: 300
                    
                    Label {
                        style: "large"
                        text: "Performance Overview"
                        y: 20
                    }


                    Card {
                        type: "outlined"
                        y: 80
                        x: 280
                        width: 230
                        height: 200
                    Card {
                        x: 20
                        y: 20
                        width: 40
                        height: 40
                        type: "filled"
                        Icon {
                            x: 26
                            y: 7
                            text: "AROMA_ICON_MULTILINE_CHART"
                            color: "#FFFFFF"
                        }
                    }

                    Label {
                        text: "Average Speed"
                        x: 70
                        y: 25
                    }
                    Divider{
                        orientation: "horizontal"
                           x: 15
                        y: 80
                        length: 195 

                    }

                    Label {
                        text: "60"
                        font: "medium_font"
                            x: 55
                        y: 100
                                                color: "#FAFAFA"

                    }
                    Label {
                        text: "km/h"
                        color: "#FAFAFA"
                        y: 135
                        x: 125
                    }
                      
                    }


                    Card {
                        type: "filled"
                        y: 520
                        x: 20
                        width: 490
                        height: 100
                  
                        Icon {
                            x: 46
                            y: 40
                            text: "AROMA_ICON_FLASH_ON"
                            color: "#FFFFFF"
                        }
                    

                    Label {
                        text: "Acceleration"
                        x: 70
                        y: 39
                    }
                 

                    Label {
                        text: "50"
                        font: "medium_font"
                        x: 300
                        y: 15
                        color: "#FAFAFA"

                    }
                    
                    Label {
                        text: "m/s²"
                        color: "#FAFAFA"
                        y: 50
                        x: 370                    
                        }
                   
                    }

                    Card {
                        type: "filled"
                        y: 410
                        x: 20
                        width: 490
                        height: 100
                  
                        Icon {
                            x: 46
                            y: 40
                            text: "AROMA_ICON_TRENDING_UP"
                            color: "#FFFFFF"
                        }
                    

                    Label {
                        text: "Kinetic Energy"
                        x: 70
                        y: 39
                    }
                 

                    Label {
                        text: "2000"
                        font: "medium_font"
                        x: 300
                        y: 15
                        color: "#FAFAFA"

                    }
                    
                    Label {
                        text: "J"
                        color: "#FAFAFA"
                        y: 50
                        x: 425                    
                        }
                   
                    }
                    Card {
                        type: "filled"
                        y: 300
                        x: 20
                        width: 490
                        height: 100
                  
                        Icon {
                            x: 46
                            y: 40
                            text: "AROMA_ICON_WHATSHOT"
                            color: "#FFFFFF"
                        }
                    

                    Label {
                        text: "Max Speed"
                        x: 70
                        y: 39
                    }
                 

                    Label {
                        text: "100"
                        font: "medium_font"
                        x: 300
                        y: 15
                        color: "#FAFAFA"

                    }
                    
                    Label {
                        text: "km/h"
                        color: "#FAFAFA"
                        y: 50
                        x: 400
                    }
                   
                    }

                    Card {
                        type: "elevated"
                        y: 80
                        x: 20
                        width: 230
                        height: 200
                    Card {
                        x: 20
                        y: 20
                        width: 40
                        height: 40
                        type: "filled"
                        Icon {
                            x: 26
                            y: 7
                            text: "AROMA_ICON_NEAR_ME"
                            color: "#FFFFFF"
                        }
                    }

                    Label {
                        text: "Distance"
                        x: 70
                        y: 25
                    }
                    Divider{
                        orientation: "horizontal"
                           x: 15
                        y: 80
                        length: 195 

                    }

                    Label {
                        text: "100"
                        font: "medium_font"
                            x: 35
                        y: 100
                                                color: "#FAFAFA"

                    }
                    Label {
                        text: "km"
                        color: "#FAFAFA"
                        y: 135
                        x: 135
                    }
                      
                    }
                        Icon {
                            text: "AROMA_ICON_ARROW_DOWNWARD"
                            color: "#FFFFFF"
                            size: 30
                            x: 270
                            y: 278
                        }
                    }
                }
                Tab {
                    id:      "car_view_tab"
                    text:   "Car View"
                    
                    Label {
                        text: "Tire Pressure"
                    }
        
                    Container {
                        width:  560
                        height: 272
                        Label {
                            text: "2.4 bar"
                            x: 130
                            y: 40
                        }

                           Label {
                            text: "2.4 bar"
                            x: 365
                            y: 40
                        }
                        Label {
                            text: "2.4 bar"
                            x: 130
                            y: 255
                        }

                           Label {
                            text: " bar"
                            x: 365
                            y: 255
                        }
                      
                        Image {
                            x:      63
                            y:      60
                            width:  424 
                            height: 202 
                            src: "../assets/topview_car.png"
                            animation: "slide_x"
                            animation_start_val: 3000
                            animation_end_val: 425
                            animation_duration: 3000
                            animation_easing: "ease_out_cubic"
                            z_index: 9999
                        }
                    }
                }
                Tab {
                    id:      "vehicle_tab"
                    text:   "Vehicle"
                    
                    Container {
                        width:  560
                        height: 272

                        Card {
                            id:     "motor_card"
                            type:   "outlined"
                            x:      0
                            y:      100
                            width:  274
                            height: 168
                            animation: "slide_y"
                            animation_start_val: -1000
                            animation_end_val: 100
                            animation_duration: 1200

                            Card {
                                x:      20
                                y:      24
                                width:  40
                                height: 40
                                type:   "filled"

                                Icon {
                                    x:     26
                                    y:     8
                                    size:  24
                                    text:  "AROMA_ICON_SETTINGS"
                                    color: "#FFFFFF"
                                }
                            }

                            Label {
                                x:     20
                                y:      80
                                text:  "Motor"
                                style: "medium"
                            }

                            Label {
                                id:    "motor_temp"
                                x:     20
                                y:      110
                                text:  "50°C"
                                style: "large"
                            }

                            Label {
                                id:    "motor_rpm"
                                x:     140
                                y:     114
                                text:  "4,200 rpm"
                                style: "medium"
                            }
                        }

                        Card {
                            id:     "efficiency_card"
                            type:   "elevated"
                            x:      286
                            y:      100
                            width:  274
                            height: 168
                            animation: "slide_y"
                            animation_start_val: 800
                            animation_end_val: 100
                            animation_duration: 1200

                            Card {
                                x:      20
                                y:      24
                                width:  40
                                height: 40
                                type:   "filled"

                                Icon {
                                    x:     25
                                    y:     8
                                    size:  24
                                    text:  "AROMA_ICON_TRENDING_UP"
                                    color: "#FFFFFF"
                                }
                            }

                            Label {
                                x:     20
                                y:      80
                                text:  "Efficiency"
                                style: "medium"
                            }

                            Label {
                                id:    "efficiency_value"
                                x:     20
                                y:      110
                                text:  "156 Wh/km"
                                style: "large"
                            }

                            Label {
                                id:    "regen_value"
                                x:     20
                                y:      140
                                text:  "2.4 kWh"
                                style: "medium"
                            }
                        }
                    }
                }

             
            }
        }