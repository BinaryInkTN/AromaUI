Window {
    title:  "Instrument Cluster"
    width:  1280
    height: 400

    Container {
        id:     "status_bar"
        x:      40
        y:      16
        width:  1200
        height: 28

        Label {
            id:    "outside_temp"
            x:     0
            y:     2
            text:  "18°C"
            style: "medium"
        }

        Card {
            x:     900
            y:     0
            height: 30
            width: 220
            type: "filled"

            Icon {
                x: 30
                y: 3
                text: "AROMA_ICON_PERSON"
                color: "#FFFFFF"
            }
            
            Label {
                y: 5
                x: 45
                text: "Welcome back, Yassine!"
                style: "small"
            }
        }

        Label {
            id:    "clock_value"
            x:     1140
            y:     2
            text:  "14:23"
            style: "medium"
        }
    }

    Divider {
        x:           40
        y:           56
        length:      1200
        orientation: "horizontal"
    }

    Container {
        id:     "main_area"
        x:      40
        y:      72
        width:  1200
        height: 312

        Container {
            id:     "speed_section"
            x:      0
            y:      60
            width:  240
            height: 240

            Label {
                id:    "speed_value"
                x:     150
                y:     10
                text:  "82"
                style: "large"
                font:  "big_font"
            }
            Label {
                x:     190
                y:     110
                text:  "km/h"
                style: "large"
            }

            Card {
                id:     "gear_selector"
                type:   "outlined"
                x:      0
                y:      150
                width:  240
                height: 40
                z_index: 0

                Card {
                    id:     "gear_active"
                    x:      3
                    y:      3
                    width:  42
                    height: 34
                    type:   "filled"
                    z_index: 1
                }

                Label {
                    x:     18
                    y:     7
                    text:  "P"
                    style: "large"
                    z_index: 2
                }
                Label {
                    x:     78
                    y:     7
                    text:  "R"
                    style: "large"
                    z_index: 2
                }
                Label {
                    x:     138
                    y:     7
                    text:  "N"
                    style: "large"
                    z_index: 2
                }
                Label {
                    x:     198
                    y:     7
                    text:  "D"
                    style: "large"
                    z_index: 2
                }
            }
        }

        Divider {
            x:           280
            y:           30
            length:      252
            orientation: "vertical"
        }

        Container {
            id:     "center_section"
            x:      320
            y:      0
            width:  560
            height: 312

            Tabs {
                id:     "center_tabs"
                x:      0
                y:      250
                width:  560
                height: 50
                hidden: true
   Tab {
                    id:      "car_view_tab"
                    text:   "Car View"
                    Label {
                        text: "Tire Pressure"
                    }
        
                    Container {
                        width:  560
                        height: 272
                        Label {
                            text: "2.4 bar"
                            x: 130
                            y: 40
                        }

                           Label {
                            text: "2.3 bar"
                            x: 365
                            y: 40
                        }
                        Label {
                            text: "2.4 bar"
                            x: 130
                            y: 255
                        }

                           Label {
                            text: "2.5 bar"
                            x: 365
                            y: 255
                        }
                        Image {
                            x:      63
                            y:      60
                            width:  424 
                            height: 202 
                            src: "../assets/topview_car.png"
                            animation: "fade"
                            animation_start_val: 0
                            animation_end_val: 1
                            animation_duration: 4000
                        }
                    }
                }
                Tab {
                    id:      "vehicle_tab"
                    text:   "Vehicle"
                    
                    Container {
                        width:  560
                        height: 272

                        Card {
                            id:     "motor_card"
                            type:   "outlined"
                            x:      0
                            y:      100
                            width:  274
                            height: 168
                            animation: "slide_y"
                            animation_start_val: -1000
                            animation_end_val: 100
                            animation_duration: 1200

                            Card {
                                x:      20
                                y:      24
                                width:  40
                                height: 40
                                type:   "filled"

                                Icon {
                                    x:     26
                                    y:     8
                                    size:  24
                                    text:  "AROMA_ICON_SETTINGS"
                                    color: "#FFFFFF"
                                }
                            }

                            Label {
                                x:     20
                                y:      80
                                text:  "Motor"
                                style: "medium"
                            }

                            Label {
                                id:    "motor_temp"
                                x:     20
                                y:      110
                                text:  "50°C"
                                style: "large"
                            }

                            Label {
                                id:    "motor_rpm"
                                x:     140
                                y:     114
                                text:  "4,200 rpm"
                                style: "medium"
                            }
                        }

                        Card {
                            id:     "efficiency_card"
                            type:   "elevated"
                            x:      286
                            y:      100
                            width:  274
                            height: 168
                            animation: "slide_y"
                            animation_start_val: 800
                            animation_end_val: 100
                            animation_duration: 1200

                            Card {
                                x:      20
                                y:      24
                                width:  40
                                height: 40
                                type:   "filled"

                                Icon {
                                    x:     25
                                    y:     8
                                    size:  24
                                    text:  "AROMA_ICON_TRENDING_UP"
                                    color: "#FFFFFF"
                                }
                            }

                            Label {
                                x:     20
                                y:      80
                                text:  "Efficiency"
                                style: "medium"
                            }

                            Label {
                                id:    "efficiency_value"
                                x:     20
                                y:      110
                                text:  "156 Wh/km"
                                style: "large"
                            }

                            Label {
                                id:    "regen_value"
                                x:     20
                                y:      140
                                text:  "2.4 kWh"
                                style: "medium"
                            }
                        }
                    }
                }

             
            }
        }

        Divider {
            x:           900
            y:           30
            length:      252
            orientation: "vertical"
        }

        Container {
            id:     "range_section"
            x:      920
            y:      50
            width:  280
            height: 312

            Label {
                x:     20
                y:     20
                text:  "State of Charge"
                style: "large"
            }

            Label {
                id:    "range_value"
                x:     20
                y:     25
                text:  "76"
                style: "large"
                font:  "big_font"
            }
            
            Label {
                x:     130
                y:     90
                text:  "%"
                style: "large"
            }

            ProgressBar {
                id:     "range_bar"
                x:      20
                y:      130
                width:  240
                height: 6
                type:   "determinate"
                value:  0.76
            }

            Label {
                id:    "battery_percent"
                x:     20
                y:      150
                text:  "412km"
                style: "large"
            }
            
            Label {
                x:     20
                y:      178
                text:  "Range Left"
                style: "medium"
            }
        }
    }
}