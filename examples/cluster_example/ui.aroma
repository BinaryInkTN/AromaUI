Window {
    title:  "Instrument Cluster"
    width:  1280
    height: 400

    Container {
        id:     "status_bar"
        x:      45
        y:      16
        width:  1200
        height: 28
        animation: "slide_y"
        animation_start_val: -100
        animation_end_val: 15
        animation_duration: 3000

        Label {
            id:    "outside_temp"
            x:     0
            y:     2
            text:  "state.outside_temp"
            style: "medium"
        }

        Card {
            x:     900
            y:     0
            height: 30
            width: 220
            type: "filled"

            Icon {
                x: 30
                y: 3
                text: "AROMA_ICON_PERSON"
                color: "#FFFFFF"
            }
            
            Label {
                y: 5
                x: 45
                text: "state.greeting"
                style: "small"
            }
        }

        Label {
            id:    "clock_value"
            x:     1140
            y:     2
            text:  "state.current_time"
            style: "medium"
        }
    }

    Divider {
        x:           40
        y:           56
        length:      1200
        orientation: "horizontal"
    }

    Container {
        id:     "main_area"
        x:      40
        y:      72
        width:  1200
        height: 312

        Container {
            id:     "speed_section"
            x:      0
            y:      60
            width:  240
            height: 240

            Label {
                id:    "speed_value"
                x:     150
                y:     10
                text:  "state.vehicle_speed"
                style: "large"
                font:  "big_font"
            }
            
            Label {
                x:     190
                y:     110
                text:  "km/h"
                style: "large"
            }

            Card {
                id:     "gear_selector"
                type:   "outlined"
                x:      0
                y:      150
                width:  240
                height: 40
                z_index: 0

                Card {
                    id:     "gear_active"
                    x:      "state.gear_x_position"
                    y:      3
                    width:  42
                    height: 34
                    type:   "filled"
                    z_index: 1
                    animation: "slide_x"
                    animation_start_val: 3
                    animation_end_val: "state.gear_x_position"
                    animation_duration: 200
                }

                Label {
                    x:     18
                    y:     7
                    text:  "P"
                    style: "large"
                    z_index: 2
                    on_click: "set_gear_park"
                }
                Label {
                    x:     78
                    y:     7
                    text:  "R"
                    style: "large"
                    z_index: 2
                    on_click: "set_gear_reverse"
                }
                Label {
                    x:     138
                    y:     7
                    text:  "N"
                    style: "large"
                    z_index: 2
                    on_click: "set_gear_neutral"
                }
                Label {
                    x:     198
                    y:     7
                    text:  "D"
                    style: "large"
                    z_index: 2
                    on_click: "set_gear_drive"
                }
            }

        }

        Divider {
            x:           280
            y:           30
            length:      252
            orientation: "vertical"
        }

        @embed "center_screen.aroma"

        Divider {
            x:           900
            y:           30
            length:      252
            orientation: "vertical"
        }

        Container {
            id:     "range_section"
            x:      920
            y:      50
            width:  280
            height: 312
       
            Label {
                x:     20
                y:     20
                text:  "State of Charge"
                style: "large"
            }

            Label {
                id:    "range_value"
                x:     20
                y:     25
                text:  "state.battery_percent"
                style: "large"
                font:  "big_font"
            }
            
            Label {
                x:     130
                y:     90
                text:  "%"
                style: "large"
            }

            ProgressBar {
                id:     "range_bar"
                x:      20
                y:      130
                width:  240
                height: 6
                type:   "determinate"
                value:  "state.battery_percent"
            }

            Label {
                id:    "battery_percent"
                x:     20
                y:      150
                text:  "state.range_remaining"
                style: "large"
            }
            
            Label {
                x:     20
                y:      178
                text:  "Range Left"
                style: "medium"
            }

            If {
                condition: "state.battery_percent < 20"
                Then {
                    Container {
                        x:      0
                        y:      210
                        width:  280
                        height: 60
                        animation: "fade"
                        animation_start_val: 0
                        animation_end_val: 1
                        animation_duration: 500

                        Card {
                            x:      0
                            y:      0
                            width:  280
                            height: 60
                            type:   "filled"
                            
                            Icon {
                                x:      10
                                y:      15
                                text:   "AROMA_ICON_BATTERY_ALERT"
                                color:  "#FFAA00"
                                size:   30
                            }
                            
                            Label {
                                x:      50
                                y:      5
                                text:   "Low Battery"
                                style:  "medium"
                            }
                            
                            Label {
                                x:      50
                                y:      30
                                text:   "state.charging_stations_nearby"
                                style:  "small"
                            }
                        }
                    }
                }
            }
        }
    }
}