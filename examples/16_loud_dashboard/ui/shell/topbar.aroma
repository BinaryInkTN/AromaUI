// shell/topbar.aroma - generated by tools/sandbox/gen_dashboard.py --split
        Container {
            x: 0
            y: 0
            width: 1280
            height: 800
        Card {
            z_index: 0
            x: 0
            y: 0
            width: 1280
            height: 800
            type: filled
            color: #000000
            corner_radius: 0
        }
        Image {
            z_index: 5
            x: 16
            y: 24
            width: 34
            height: 34
            src: "assets/loud_logo.png"
            scale: cover
            corner_radius: 17
        }
        Label {
            z_index: 5
            id: "loud_brand"
            text: "Loud"
            size: 26
            color: #FFFFFF
            x: 58
            y: 23
        }
        Button {
            z_index: 22
            x: 12
            y: 18
            width: 118
            height: 48
            text: ""
            type: text
            on_click: "dashboard_nav_0"
        }
        @embed "nav_pill.aroma" { idx: "0", x: "376", w: "108", lx: "396", bg: "1A1A1C", fg: "B9B9BE", text: "Dashboard", cb: "dashboard_nav_0" }
        @embed "nav_pill.aroma" { idx: "1", x: "494", w: "90", lx: "511", bg: "FFFFFF", fg: "000000", text: "Analytics", cb: "dashboard_nav_1" }
        @embed "nav_pill.aroma" { idx: "2", x: "594", w: "120", lx: "614", bg: "1A1A1C", fg: "B9B9BE", text: "Transactions", cb: "dashboard_nav_2" }
        @embed "nav_pill.aroma" { idx: "3", x: "724", w: "94", lx: "745", bg: "1A1A1C", fg: "B9B9BE", text: "Reports", cb: "dashboard_nav_3" }
        @embed "nav_pill.aroma" { idx: "4", x: "828", w: "80", lx: "842", bg: "1A1A1C", fg: "B9B9BE", text: "Settings", cb: "dashboard_nav_4" }
        IconButton {
            z_index: 5
            id: "top_search"
            x: 1104
            y: 26
            size: 40
            icon_size: 18
            icon: "AROMA_ICON_SEARCH"
            variant: filled
            color: #1C1C1E
            icon_color: #E4E4E8
            on_click: "dashboard_search_open"
        }
        IconButton {
            z_index: 5
            id: "top_mail"
            x: 1154
            y: 26
            size: 40
            icon_size: 18
            icon: "AROMA_ICON_MAIL_OUTLINE"
            variant: filled
            color: #1C1C1E
            icon_color: #E4E4E8
            on_click: "dashboard_notifications"
        }
        Card {
            z_index: 6
            id: "mail_badge"
            x: 1181
            y: 30
            width: 9
            height: 9
            type: filled
            color: #A78BFA
            corner_radius: 5
        }
        Image {
            z_index: 5
            id: "top_avatar"
            x: 1208
            y: 22
            width: 44
            height: 44
            src: "assets/angela.png"
            scale: cover
            corner_radius: 22
        }
        Button {
            z_index: 22
            x: 1200
            y: 16
            width: 60
            height: 56
            text: ""
            type: text
            on_click: "dashboard_profile"
        }
        }
