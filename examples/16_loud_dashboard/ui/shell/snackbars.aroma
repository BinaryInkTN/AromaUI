// shell/snackbars.aroma - generated by tools/sandbox/gen_dashboard.py --split
        Container {
            x: 0
            y: 0
            width: 1280
            height: 800
        @embed "snackbar.aroma" { id: "transfer", text: "Transfer scheduled" }
        @embed "snackbar.aroma" { id: "request", text: "Request created" }
        @embed "snackbar.aroma" { id: "report", text: "Report downloaded" }
        @embed "snackbar.aroma" { id: "receipt", text: "Receipt downloaded" }
        @embed "snackbar.aroma" { id: "saved", text: "Profile saved" }
        @embed "snackbar.aroma" { id: "prefs", text: "Preferences updated" }
        @embed "snackbar.aroma" { id: "privacy_on", text: "Balances hidden" }
        @embed "snackbar.aroma" { id: "privacy_off", text: "Balances visible" }
        @embed "snackbar.aroma" { id: "reviewed", text: "Marked as reviewed" }
        @embed "snackbar.aroma" { id: "reset", text: "Demo data restored" }
        @embed "snackbar.aroma" { id: "chart_export", text: "Chart data downloaded" }
        @embed "snackbar.aroma" { id: "welcome", text: "Welcome back, Angela" }
        @embed "snackbar.aroma" { id: "heat", text: "Activity data exported" }
        @embed "snackbar.aroma" { id: "invalid", text: "Check the highlighted fields" }
        }
