// overlays/request.aroma - generated by tools/sandbox/gen_dashboard.py --split
        Container {
            id: "overlay_request"
            x: 0
            y: 0
            width: 1280
            height: 800
            visible: 0
        Card {
            z_index: 50
            x: 0
            y: 0
            width: 1280
            height: 800
            type: filled
            color: #B3000000
            corner_radius: 0
        }
        Button {
            z_index: 51
            x: 0
            y: 0
            width: 1280
            height: 800
            text: ""
            type: text
            on_click: "dashboard_close_overlay"
        }
        Card {
            z_index: 52
            x: 340
            y: 110
            width: 600
            height: 580
            type: filled
            color: #1A1A1C
            corner_radius: 24
        }
        Button {
            z_index: 53
            x: 340
            y: 110
            width: 600
            height: 580
            text: ""
            type: text
            on_click: "dashboard_noop"
        }
        Label {
            z_index: 60
            text: "Request money"
            size: 26
            color: #FFFFFF
            x: 372
            y: 136
        }
        Label {
            z_index: 60
            text: "Create a payment link for a client or friend."
            size: 12
            color: #A6A6AB
            x: 372
            y: 174
        }
        IconButton {
            z_index: 70
            x: 860
            y: 130
            size: 44
            icon_size: 18
            icon: "AROMA_ICON_CLOSE"
            variant: filled
            color: #232325
            icon_color: #BCBCC1
            on_click: "dashboard_close_overlay"
        }
        Label {
            z_index: 60
            text: "Who should pay?"
            size: 12
            color: #A6A6AB
            x: 372
            y: 216
        }
        Textbox {
            z_index: 60
            id: "request_payer"
            x: 372
            y: 236
            width: 536
            height: 46
            placeholder: "Name or email"
        }
        Label {
            z_index: 60
            text: "Amount"
            size: 12
            color: #A6A6AB
            x: 372
            y: 300
        }
        Textbox {
            z_index: 60
            id: "request_amount"
            x: 372
            y: 320
            width: 536
            height: 46
            placeholder: "0.00"
        }
        @embed "amount_chip.aroma" { text: "$50", x: "372", tx: "395", cb: "dashboard_request_amount_0" }
        @embed "amount_chip.aroma" { text: "$100", x: "452", tx: "475", cb: "dashboard_request_amount_1" }
        @embed "amount_chip.aroma" { text: "$500", x: "532", tx: "555", cb: "dashboard_request_amount_2" }
        Label {
            z_index: 60
            id: "request_error"
            visible: 0
            text: ""
            size: 12
            color: #FF9CAE
            x: 372
            y: 432
        }
        Card {
            z_index: 60
            x: 372
            y: 598
            width: 150
            height: 44
            type: filled
            color: #232325
            corner_radius: 22
        }
        Label {
            z_index: 62
            text: "Cancel"
            size: 14
            color: #FFFFFF
            x: 420
            y: 611
        }
        Button {
            z_index: 64
            x: 372
            y: 598
            width: 150
            height: 44
            text: ""
            type: text
            on_click: "dashboard_close_overlay"
        }
        Card {
            z_index: 60
            x: 774
            y: 598
            width: 134
            height: 44
            type: filled
            color: #FFFFFF
            corner_radius: 22
        }
        Label {
            z_index: 62
            text: "Create request"
            size: 14
            color: #000000
            x: 795
            y: 611
        }
        Button {
            z_index: 64
            x: 774
            y: 598
            width: 134
            height: 44
            text: ""
            type: text
            on_click: "dashboard_request_submit"
        }
        }
