
        Container {
            id: "overlay_search"
            x: 0
            y: 0
            width: 1280
            height: 800
            visible: 0
        Card {
            z_index: 50
            x: 0
            y: 0
            width: 1280
            height: 800
            type: filled
            color: #B3000000
            corner_radius: 0
        }
        Button {
            z_index: 51
            x: 0
            y: 0
            width: 1280
            height: 800
            text: ""
            type: text
            on_click: "dashboard_close_overlay"
        }
        Card {
            z_index: 52
            x: 340
            y: 80
            width: 600
            height: 620
            type: filled
            color: #1A1A1C
            corner_radius: 24
        }
        Button {
            z_index: 53
            x: 340
            y: 80
            width: 600
            height: 620
            text: ""
            type: text
            on_click: "dashboard_noop"
        }
        Label {
            z_index: 60
            text: "Search"
            size: 26
            color: #FFFFFF
            x: 372
            y: 106
        }
        IconButton {
            z_index: 70
            x: 860
            y: 100
            size: 44
            icon_size: 18
            icon: "AROMA_ICON_CLOSE"
            variant: filled
            color: #232325
            icon_color: #BCBCC1
            on_click: "dashboard_close_overlay"
        }
        Textbox {
            z_index: 60
            id: "search_input"
            x: 372
            y: 154
            width: 536
            height: 46
            placeholder: "Search transactions, categories, or amounts"
            on_change: "dashboard_search_change"
        }
        Label {
            z_index: 60
            text: "RECENT AND MATCHING TRANSACTIONS"
            size: 12
            color: #77777D
            x: 372
            y: 220
        }
        @embed "search_row.aroma" { idx: "0", y: "250", y1: "260", y2: "281", y3: "267", cb: "dashboard_search_hit0" }
        @embed "search_row.aroma" { idx: "1", y: "314", y1: "324", y2: "345", y3: "331", cb: "dashboard_search_hit1" }
        @embed "search_row.aroma" { idx: "2", y: "378", y1: "388", y2: "409", y3: "395", cb: "dashboard_search_hit2" }
        @embed "search_row.aroma" { idx: "3", y: "442", y1: "452", y2: "473", y3: "459", cb: "dashboard_search_hit3" }
        @embed "search_row.aroma" { idx: "4", y: "506", y1: "516", y2: "537", y3: "523", cb: "dashboard_search_hit4" }
        Label {
            z_index: 60
            id: "search_empty"
            visible: 0
            text: "No transactions match your search."
            size: 16
            color: #A6A6AB
            x: 372
            y: 276
        }
        Label {
            z_index: 60
            text: "Click outside to close"
            size: 12
            color: #77777D
            x: 372
            y: 662
        }
        }
