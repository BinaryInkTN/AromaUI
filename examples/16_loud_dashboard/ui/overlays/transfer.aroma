            y: 172
        }
        IconButton {
            z_index: 70
            x: 860
            y: 130
            size: 44
            icon_size: 18
            icon: "AROMA_ICON_CLOSE"
            variant: filled
            color: #232325
            icon_color: #BCBCC1
            on_click: "dashboard_close_overlay"
        }
        Label {
            z_index: 60
            text: "Recipient"
            size: 12
            color: #A6A6AB
            x: 372
            y: 216
        }
        Textbox {
            z_index: 60
            id: "transfer_recipient"
            x: 372
            y: 236
            width: 536
            height: 46
            placeholder: "Name or @handle"
        }
        Label {
            z_index: 60
            text: "Amount"
            size: 12
            color: #A6A6AB
            x: 372
            y: 300
        }
        Textbox {
            z_index: 60
            id: "transfer_amount"
            x: 372
            y: 320
            width: 536
            height: 46
            placeholder: "0.00"
        }
        @embed "amount_chip.aroma" { text: "$50", x: "372", tx: "395", cb: "dashboard_transfer_amount_0" }
        @embed "amount_chip.aroma" { text: "$100", x: "452", tx: "475", cb: "dashboard_transfer_amount_1" }
        @embed "amount_chip.aroma" { text: "$500", x: "532", tx: "555", cb: "dashboard_transfer_amount_2" }
        Label {
            z_index: 60
            id: "transfer_error"
            visible: 0
            text: ""
            size: 12
            color: #FF9CAE
            x: 372
            y: 432
        }
