
        Container {
            id: "overlay_transfer"
            x: 0
            y: 0
            width: 1280
            height: 800
            visible: 0
        Card {
            z_index: 50
            x: 0
            y: 0
            width: 1280
            height: 800
            type: filled
            color: #B3000000
            corner_radius: 0
        }
        Button {
            z_index: 51
            x: 0
            y: 0
            width: 1280
            height: 800
            text: ""
            type: text
            on_click: "dashboard_close_overlay"
        }
        Card {
            z_index: 52
            x: 340
            y: 110
            width: 600
            height: 580
            type: filled
            color: #1A1A1C
            corner_radius: 24
        }
        Button {
            z_index: 53
            x: 340
            y: 110
            width: 600
            height: 580
            text: ""
            type: text
            on_click: "dashboard_noop"
        }
        Label {
            z_index: 60
            text: "Transfer money"
            size: 26
            color: #FFFFFF
            x: 372
            y: 136
        }
        Label {
            z_index: 60
            text: "Send from Checking  •••• 4821"
            size: 12
            color: #A6A6AB
            x: 372
            y: 174
        }
        Label {
            z_index: 60
            text: "Available"
            size: 12
            color: #A6A6AB
