
        Container {
            id: "page_settings"
            x: 0
            y: 0
            width: 1280
            height: 800
            visible: 0
        Label {
            z_index: 4
            text: "Settings"
            size: 40
            color: #FFFFFF
            x: 24
            y: 120
        }
        Label {
            z_index: 4
            text: "Manage your profile, alerts, privacy, and demo session."
            size: 14
            color: #A6A6AB
            x: 24
            y: 172
        }
        Card {
            z_index: 2
            x: 24
            y: 206
            width: 600
            height: 252
            type: filled
            color: #1A1A1C
            corner_radius: 22
            interactive: true
        }
        Icon {
            z_index: 4
            x: 48
            y: 228
            size: 20
            icon_size: 20
            text: "AROMA_ICON_PERSON"
            color: #FFFFFF
        }
        Label {
            z_index: 4
            text: "Profile"
            size: 20
            color: #FFFFFF
            x: 78
            y: 226
        }
        Label {
            z_index: 4
            text: "Display name"
            size: 12
            color: #A6A6AB
            x: 48
            y: 270
        }
        Textbox {
            z_index: 6
            id: "settings_name"
            x: 48
            y: 290
            width: 552
            height: 42
            placeholder: "Your name"
        }
        Label {
            z_index: 4
            text: "Email"
            size: 12
            color: #A6A6AB
            x: 48
            y: 346
        }
        Textbox {
            z_index: 6
            id: "settings_email"
            x: 48
            y: 366
            width: 360
            height: 42
            placeholder: "you@example.com"
        }
        Card {
            z_index: 28
            x: 420
            y: 366
            width: 180
            height: 42
            type: filled
            color: #FFFFFF
            corner_radius: 21
        }
        Label {
            z_index: 30
            text: "Save profile"
            size: 14
            color: #000000
            x: 460
            y: 378
        }
        Button {
            z_index: 32
            x: 420
            y: 366
            width: 180
            height: 42
            text: ""
            type: text
            on_click: "dashboard_settings_save"
        }
        Label {
            z_index: 4
            id: "settings_status"
            text: ""
            size: 12
            color: #A6A6AB
            x: 48
            y: 424
        }
        Card {
            z_index: 2
            x: 648
            y: 206
            width: 608
            height: 252
            type: filled
            color: #1A1A1C
            corner_radius: 22
