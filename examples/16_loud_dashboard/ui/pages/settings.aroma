        }
        Icon {
            z_index: 4
            x: 672
            y: 228
            size: 20
            icon_size: 20
            text: "AROMA_ICON_NOTIFICATIONS"
            color: #FFFFFF
        }
        Label {
            z_index: 4
            text: "Notifications"
            size: 20
            color: #FFFFFF
            x: 702
            y: 226
        }
        @embed "settings/pref_row.aroma" { name: "Weekly summary", desc: "Spending and revenue digest every Monday.", idx: "0", value: "true", y: "278", y2: "298", y3: "276" }
        @embed "settings/pref_row.aroma" { name: "Large transactions", desc: "Alert me when a movement exceeds $250.", idx: "1", value: "true", y: "334", y2: "354", y3: "332" }
        @embed "settings/pref_row.aroma" { name: "Product updates", desc: "Occasional news about new features.", idx: "2", value: "false", y: "390", y2: "410", y3: "388" }
        Label {
            z_index: 4
            id: "settings_pref_status"
