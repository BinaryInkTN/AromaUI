
        Container {
            id: "page_dashboard"
            x: 0
            y: 0
            width: 1280
            height: 800
            visible: 0
        Label {
            z_index: 4
            text: "Overview"
            size: 40
            color: #FFFFFF
            x: 24
            y: 120
        }
        Label {
            z_index: 4
            text: "Here is how your money is moving this month."
            size: 14
            color: #A6A6AB
            x: 24
            y: 172
        }
        @embed "dashboard/kpis.aroma"
        @embed "dashboard/cashflow.aroma"
        @embed "dashboard/activity_card.aroma"
        @embed "dashboard/actions.aroma"
        }
