Window {
    width: 360
    height: 780
    title: "Layout"

    Label { text: "Morning briefing" x: 16 y: 16 style: "large" }
    Label { text: "Stats and scrolling feed" x: 16 y: 48 style: "small" }
    Container {
        id: "main_container"
        x: 16
        y: 88
        width: 328
        height: 118
        layout: flex
        direction: row
       
            Card { width: 100 height: 108 type: filled
                Label { text: "12.4k" x: 10 y: 10 style: "large" }
                Label { text: "Steps" x: 10 y: 52 style: "small" }
                Label { text: "+8% today" x: 10 y: 76 style: "small" }
            }
            Card { width: 100 height: 108 type: outlined
                Label { text: "86" x: 10 y: 10 style: "large" }
                Label { text: "Tasks" x: 10 y: 52 style: "small" }
                Label { text: "4 overdue" x: 10 y: 76 style: "small" }
            }
            Card { width: 100 height: 108 type: elevated
                Label { text: "22C" x: 10 y: 10 style: "large" }
                Label { text: "Sunny" x: 10 y: 52 style: "small" }
                Label { text: "Kyoto" x: 10 y: 76 style: "small" }
            }
        
    }

    Divider { x: 16 y: 222 length: 328 orientation: horizontal }

    Label { text: "Feed" x: 16 y: 242 style: "large" }
    ScrollView {
        x: 16
        y: 276
        width: 328
        height: 380
        direction: vertical

        Card { x: 0 y: 0 width: 296 height: 64 type: outlined
            Label { text: "Design review at 10" x: 14 y: 8 style: "medium" }
            Label { text: "2h ago - 12 comments" x: 14 y: 34 style: "small" }
        }
        Card { x: 0 y: 76 width: 296 height: 64 type: outlined
            Label { text: "Lunch with Ken" x: 14 y: 8 style: "medium" }
            Label { text: "4h ago - 3 comments" x: 14 y: 34 style: "small" }
        }
        Card { x: 0 y: 152 width: 296 height: 64 type: outlined
            Label { text: "Release 2.4 ships" x: 14 y: 8 style: "medium" }
            Label { text: "6h ago - 48 comments" x: 14 y: 34 style: "small" }
        }
        Card { x: 0 y: 228 width: 296 height: 64 type: outlined
            Label { text: "Gym: legs day" x: 14 y: 8 style: "medium" }
            Label { text: "8h ago - 1 comment" x: 14 y: 34 style: "small" }
        }
        Card { x: 0 y: 304 width: 296 height: 64 type: outlined
            Label { text: "Call with bank" x: 14 y: 8 style: "medium" }
            Label { text: "Yesterday - no comments" x: 14 y: 34 style: "small" }
        }
        Card { x: 0 y: 380 width: 296 height: 64 type: outlined
            Label { text: "Read 20 pages" x: 14 y: 8 style: "medium" }
            Label { text: "Yesterday - 5 comments" x: 14 y: 34 style: "small" }
        }
        Card { x: 0 y: 456 width: 296 height: 64 type: outlined
            Label { text: "Water the plants" x: 14 y: 8 style: "medium" }
            Label { text: "2 days ago - 2 comments" x: 14 y: 34 style: "small" }
        }
        Card { x: 0 y: 532 width: 296 height: 64 type: outlined
            Label { text: "Plan weekend trip" x: 14 y: 8 style: "medium" }
            Label { text: "2 days ago - 9 comments" x: 14 y: 34 style: "small" }
        }
    }
}
