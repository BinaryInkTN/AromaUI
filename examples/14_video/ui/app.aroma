Window {
    width: 360
    height: 600
    title: "Video Playback"

    Label { text: "Video playback" x: 20 y: 20 style: "large" }
    Label { id: "source" text: "Sintel (CC-BY) sample clip" x: 20 y: 52 style: "small" }

    Video { id: "player" x: 20 y: 84 width: 320 height: 180 scale: "fit" corner_radius: 12 autoplay: true loop: true muted: false }

    Label { id: "status" text: "ready" x: 20 y: 276 style: "small" }

    Button { text: "Play" x: 20 y: 312 width: 100 height: 44 type: filled on_click: "play" }
    Button { text: "Pause" x: 130 y: 312 width: 100 height: 44 type: outlined on_click: "pause" }
    Button { text: "Stop" x: 240 y: 312 width: 100 height: 44 type: outlined on_click: "stop" }

    Label { text: "Codecs play here:" x: 20 y: 380 style: "medium" }
    Label { text: "MP4/H.264, WebM/VP9, MKV, AVI, WMV, MPG" x: 20 y: 404 style: "small" }
    Label { text: "assets/sample_sintel.mp4 (.mpg too)" x: 20 y: 424 style: "small" }
    Label { text: "Vendored FFmpeg, no system deps" x: 20 y: 444 style: "small" }
}
