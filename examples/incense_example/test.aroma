Window {
    width: 800
    height: 600
    title: "My Aroma Application"

    Tabs {
        x: 0
        y: 0
        width: 800
        height: 50
        id: "tab1"
        Tab {
            text: "hello"
            Button {
                x: 20
                y: 60
                text: "Hi"
                animation: "slide_x"
                animation_start_val: -100
                animation_end_val: 200
                animation_duration: 2000
            }
        }

        Tab {
            text: "hi"
            @embed "ui.aroma"
        }
    }
}